# Backend Environment Configuration

# Server Port
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/road_defects?schema=public"

# JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key"

# External FastAPI Pothole Detection Microservice
ML_SERVICE_URL="http://localhost:8000/predict"

# Development AI Fallback Flag (Set to "true" only for offline local dev)
ENABLE_DEV_MOCK_AI="false"

# Cloudinary Cloud Storage Credentials
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
