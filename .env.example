# Database Configuration (PostgreSQL)
# Required for: backend, @repo/database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/road_defects?schema=public"

# Backend Server Configuration
# Required for: backend (Express API)
PORT=3000

# Authentication & Security
# Required for: backend (Officer and Admin JWT signing/verification)
JWT_SECRET="your-super-secret-jwt-key"

# AI Inference Microservice (FastAPI / YOLO)
# Required for: backend (Calling external pothole detection service)
ML_SERVICE_URL="http://localhost:8000/predict"

# Development AI Fallback Flag (Optional, development only)
# Required for: backend (Explicitly enables mock output when ML microservice is offline)
ENABLE_DEV_MOCK_AI="false"

# Cloud Storage Configuration (Cloudinary)
# Required for: backend (Multer image upload storage)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Frontend Configuration
# Required for: frontend (Vite environment base URL for API communication)
VITE_API_URL="http://localhost:3000/api"
